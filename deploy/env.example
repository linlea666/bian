# /opt/bian/.env —— 只有 bian 用户可读（权限 600）。不要提交到 git，不要发给别人。
# 每行 KEY=VALUE；注释必须单独占一行（值里的 # 会被当作值的一部分）。

# ---- 币安网页登录凭证（读取我的跟单仓位、总止损设置）
# 浏览器登录 binance.com → F12 → Application → Cookies → p20t；csrftoken 在任意 bapi 请求的请求头里。
# 通常 7–30 天过期；过期后 bian 会发紧急提醒，按同样方法更新后执行：systemctl restart bian
BINANCE_P20T=
BINANCE_CSRFTOKEN=

# ---- 邮件提醒（SMTP）。163 邮箱：设置 → POP3/SMTP/IMAP → 开启 SMTP 服务，获取“授权码”
# 阿里云服务器默认封禁 25 端口，请用 465（tls）或 587（starttls）
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
# 邮箱授权码，不是网页登录密码
SMTP_PASS=
# 收件人，多个用逗号分隔；不填则发给 SMTP_USER 自己
SMTP_TO=
# 可选：tls 或 starttls（不填时 465=tls，其他端口=starttls）
# SMTP_SECURITY=tls

# ---- 可选：Telegram（同时需要在 config.toml 里把 telegram 设为 true）
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
